# Ignore Flutter/Dart files in root
/pubspec.yaml
/pubspec.lock
/.metadata
/analysis_options.yaml
/lib/
/android/
/ios/
/macos/
/linux/
/windows/
/web/
/test/

# Ignore documentation in root
/*.md
/docs/
/scripts/

# Ignore git
.git
.gitignore

# Ignore IDE files
.vscode/
.idea/

# Ignore node modules everywhere
**/node_modules/
**/.next/
**/.env.local

# Ignore root level files we don't need
/next-env.d.ts
/next.config.js
/next.config.ts
/package.json
/package-lock.json
/tailwind.config.js
/tsconfig.json
/vercel.json
